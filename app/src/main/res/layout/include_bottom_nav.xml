<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="36dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="dashboard">
            <com.example.mugangaconnect.ui.view.LucideIconView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/dashboard"
                app:lucideIcon="layout_dashboard"
                android:tint="#667A90"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/dashboard"
                android:textColor="#667A90"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="schedule">
            <com.example.mugangaconnect.ui.view.LucideIconView
                android:layout_width="20dp"
                android:layout_height="22dp"
                android:contentDescription="@string/schedule"
                app:lucideIcon="calendar_days"
                android:tint="#667A90"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/schedule"
                android:textColor="#667A90"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAiAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="ai_assistant">
            <com.example.mugangaconnect.ui.view.LucideIconView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/ai_assistant"
                app:lucideIcon="bot"
                android:tint="#667A90"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_assistant"
                android:textColor="#667A90"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="profile">
            <com.example.mugangaconnect.ui.view.LucideIconView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/profile_nav"
                app:lucideIcon="user_round"
                android:tint="#667A90"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_nav"
                android:textColor="#667A90"
                android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
