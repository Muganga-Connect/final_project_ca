<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Care Hub"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_blue"
                android:layout_marginBottom="20dp"/>

            <!-- Tabs: Upcoming / Rescheduled / Cancelled -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tabUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Upcoming"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    android:background="@drawable/bg_tab_active"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tabRescheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Rescheduled"
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    android:background="@drawable/bg_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tabCancelledHub"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cancelled"
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    android:background="@drawable/bg_tab_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"/>

            </LinearLayout>

            <!-- Featured Appointment Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/featuredAppointmentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Date + Info Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Date Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="64dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/field_background">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvFeaturedMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NOV"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary_blue"/>
                                <TextView
                                    android:id="@+id/tvFeaturedDay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="24"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_blue"/>
                                <TextView
                                    android:id="@+id/tvFeaturedDow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="WED"
                                    android:textSize="10sp"
                                    android:textColor="@color/text_blue"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Title + Doctor -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/tvFeaturedTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Neurological Follow-up"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_blue"/>
                            <TextView
                                android:id="@+id/tvFeaturedDoctor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dr. Sarah Chen"
                                android:textSize="13sp"
                                android:textColor="@color/text_hint"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Time + Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_hint"/>
                        <TextView
                            android:id="@+id/tvFeaturedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:30 AM"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginStart="4dp"/>
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/text_hint"
                            android:layout_marginStart="12dp"/>
                        <TextView
                            android:id="@+id/tvFeaturedLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Building B, Room 402"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <!-- Confirm Presence -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmPresence"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="✓  Confirm Presence"
                        app:cornerRadius="10dp"
                        android:backgroundTint="#E8F5E9"
                        android:textColor="#2E7D32"
                        android:textAllCaps="false"
                        android:layout_marginBottom="10dp"/>

                    <!-- Reschedule + Cancel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReschedule"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Reschedule"
                            app:cornerRadius="10dp"
                            android:textColor="@color/warning_orange"
                            android:textAllCaps="false"
                            android:layout_marginEnd="8dp"
                            app:strokeColor="@color/warning_orange_light"
                            app:strokeWidth="1dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancel"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="✕  Cancel"
                            app:cornerRadius="10dp"
                            android:textColor="@color/error_red"
                            android:textAllCaps="false"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- More Appointments header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="More Appointments"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_blue"/>
                <TextView
                    android:id="@+id/tvViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textSize="13sp"
                    android:textColor="@color/primary_blue"/>
            </LinearLayout>

            <!-- Appointments RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_appointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="20dp"/>

            <!-- Smart Scheduling Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F0FE"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✦"
                                android:textSize="16sp"
                                android:textColor="@color/primary_blue"
                                android:layout_marginEnd="6dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart Scheduling"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_blue"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="We'll find the best time for you based on your availability and no-show risk."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="10dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLearnMore"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Learn More"
                            app:cornerRadius="8dp"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:strokeColor="@color/primary_blue"
                            android:textColor="@color/primary_blue"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/primary_blue"
                        android:alpha="0.3"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Book Appointment Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_appointment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Book Appointment  →"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                android:backgroundTint="@color/primary_blue"
                app:cornerRadius="28dp"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/include_bottom_nav"
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
